{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAS Air Intelligence",
  "version": "0.3.0",
  "identifier": "fm.nas.air-intelligence",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NAS Air Intelligence",
        "width": 1312,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nas-air-sidecar"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2NkUwQjQ1QzM5N0M1MUUKUldRZXhaZkRSUXR1VmlLTm5DY3hXMlZrYmlPY3hZZVk2a2t0R1BvdDFFak5mYVNpakhlSXJHQ2wK",
      "endpoints": [
        "https://github.com/sufyanaser/NAS-Air-Intelligence/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
